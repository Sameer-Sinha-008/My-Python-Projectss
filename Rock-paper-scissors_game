import random

def check(comp, user):
    if (comp == 0 and user == 1) or (comp == 1 and user == 2) or (comp == 2 and user == 1):
        return 1
comp = random.randint(0, 2)
user = int(input("0 for Rock, 1 for Paper and 2 for Scissors:\n"))

score = check(comp, user)
print("You: ", user)
print("Computer: ", comp)
if score == 0:
    print("It is a Draw!")
elif score == 1:
    print("You WON!!")
else:
    print("Computer Won!")
